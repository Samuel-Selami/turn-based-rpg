  lines:
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 6746a710052f08a40b8c564d136c540e, type: 3}
    isplayerSide: 1
    text: "Un chariot abandonn\xE9..."
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 6746a710052f08a40b8c564d136c540e, type: 3}
    isplayerSide: 1
    text: "La roue est encore en place, mais la structure est d\xE9fonc\xE9e."
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: baf74215897961846b37da5ec1aed182, type: 3}
    isplayerSide: 1
    text: "Qu'est-ce qui a bien pu faire \xE7a ?"
