  lines:
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 6746a710052f08a40b8c564d136c540e, type: 3}
    isplayerSide: 1
    text: Presque toutes vides...
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 6746a710052f08a40b8c564d136c540e, type: 3}
    isplayerSide: 1
    text: "Ils ont emport\xE9 ce qu'ils pouvaient."
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: baf74215897961846b37da5ec1aed182, type: 3}
    isplayerSide: 1
    text: "Le reste a \xE9t\xE9 laiss\xE9 derri\xE8re."
