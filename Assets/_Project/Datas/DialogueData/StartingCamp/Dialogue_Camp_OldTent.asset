  lines:
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: e20dc51de386a4e4a8b28c935fc800dd, type: 3}
    isplayerSide: 1
    text: Pas la meilleure nuit de ma vie...
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: c9bbd78d0ec6f4a4c9e7d83519ffe6d1, type: 3}
    isplayerSide: 1
    text: Mais au moins, j'ai pu dormir au sec.
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 7ce771256d339db419624dfa47edf562, type: 3}
    isplayerSide: 1
    text: Allez, il est temps de reprendre la route.
