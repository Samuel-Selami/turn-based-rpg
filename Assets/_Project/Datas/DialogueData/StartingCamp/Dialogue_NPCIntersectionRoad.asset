--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9db5513404d9f4540b96986b47aac0e8, type: 3}
  m_Name: Dialogue_NPCIntersectionRoad
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Garde
    portrait: {fileID: 21300000, guid: a7ea2b56d5ef2e6459eb6394b8874d8f, type: 3}
    isplayerSide: 0
    text: "Halte ! Cette route est ferm\xE9e jusqu'\xE0 nouvel ordre."
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 1a276208863cee743a0482a24de5ecad, type: 3}
    isplayerSide: 1
    text: "Qu'est-ce qui s'est pass\xE9 ?"
  - speakerName: Garde
    portrait: {fileID: 21300000, guid: 49af65d4a5e1c8544b37b7f26372e932, type: 3}
    isplayerSide: 0
    text: "Plusieurs convois ont \xE9t\xE9 attaqu\xE9s ces derniers jours. On pr\xE9f\xE8re \xE9viter d'autres accidents."
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: e20dc51de386a4e4a8b28c935fc800dd, type: 3}
    isplayerSide: 1
    text: Je vois. Et pour rejoindre Valbrume ?
  - speakerName: Garde
    portrait: {fileID: 21300000, guid: 49af65d4a5e1c8544b37b7f26372e932, type: 3}
    isplayerSide: 0
    text: "Prenez le chemin qui longe l'\xE9tang, vers l'est. Vous arriverez directement au village."
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 48a4ba3a1ee53b64ea756a99a8c6e6cb, type: 3}
    isplayerSide: 1
    text: Compris. Merci.
