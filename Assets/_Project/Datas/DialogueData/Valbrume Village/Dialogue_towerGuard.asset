--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9db5513404d9f4540b96986b47aac0e8, type: 3}
  m_Name: Dialogue_towerGuard
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Garde
    portrait: {fileID: 21300000, guid: a7ea2b56d5ef2e6459eb6394b8874d8f, type: 3}
    isplayerSide: 0
    text: "Vous venez de la route foresti\xE8re ?"
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 504e965a9ab50a744a036141224c76ca, type: 3}
    isplayerSide: 1
    text: Oui. Pourquoi ?
  - speakerName: Garde
    portrait: {fileID: 21300000, guid: 19781600217d5d843a34090250635995, type: 3}
    isplayerSide: 0
    text: Vous n'avez pas eu d'ennuis en chemin ?
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 504e965a9ab50a744a036141224c76ca, type: 3}
    isplayerSide: 1
    text: "Rien que je n'aie pu g\xE9rer."
  - speakerName: Garde
    portrait: {fileID: 21300000, guid: 49af65d4a5e1c8544b37b7f26372e932, type: 3}
    isplayerSide: 0
    text: "Hm. Vous avez eu de la chance. Les routes sont moins s\xFBres qu'avant."
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 1a276208863cee743a0482a24de5ecad, type: 3}
    isplayerSide: 1
    text: "J'ai remarqu\xE9 quelques barricades."
  - speakerName: Garde
    portrait: {fileID: 21300000, guid: 49af65d4a5e1c8544b37b7f26372e932, type: 3}
    isplayerSide: 0
    text: "On pr\xE9f\xE8re \xEAtre prudents. C'est tout."
