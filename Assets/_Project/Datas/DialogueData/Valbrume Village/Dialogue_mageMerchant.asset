  m_Script: {fileID: 11500000, guid: 9db5513404d9f4540b96986b47aac0e8, type: 3}
  m_Name: Dialogue_mageMerchant
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Mage
    portrait: {fileID: 21300000, guid: 28ba6e4c1c2188347bcc9c1dd391e00b, type: 3}
    isplayerSide: 0
    text: "Bienvenue ! Rem\xE8des, provisions, talismans ! Tout pour les aventuriers !"
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 7ce771256d339db419624dfa47edf562, type: 3}
    isplayerSide: 1
    text: Des talismans ?
  - speakerName: Mage
    portrait: {fileID: 21300000, guid: 28ba6e4c1c2188347bcc9c1dd391e00b, type: 3}
    isplayerSide: 0
    text: "Pour les pactes, \xE9videmment. Vous cherchez un mod\xE8le particulier ?"
  - speakerName: Kael
    portrait: {fileID: 21300000, guid: 7ce771256d339db419624dfa47edf562, type: 3}
    isplayerSide: 1
    text: Non. Je regardais simplement.
  - speakerName: Mage
    portrait: {fileID: 21300000, guid: 28ba6e4c1c2188347bcc9c1dd391e00b, type: 3}
    isplayerSide: 0
    text: "Eh bien, n'h\xE9sitez pas ! Un bon compagnon peut vous sauver la vie !"
